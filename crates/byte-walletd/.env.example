# byte-walletd configuration.
#
# Copy to .env and fill in. Secrets are read from the environment only, never from
# command-line flags: arguments are visible in `ps` output, shell history and process
# listings, so a seed passed that way is disclosed to every other user on the machine.
#
# .env is gitignored. Do not commit a filled-in copy.

# Bearer token the JSON API requires. At least 16 characters.
# Generate one with:  openssl rand -hex 32
BYTE_WALLETD_TOKEN=

# Set EXACTLY ONE of the two below.
#
# A wallet that can spend. Hex-encoded seed, 32 to 252 bytes.
# Generate one with:  openssl rand -hex 32
# BYTE_WALLETD_SEED=
#
# A wallet that can verify but not spend. This is what a facilitator runs: with no seed
# in the process, a full compromise of it still cannot move funds. Get it from a spending
# wallet's GET /viewing-key.
# BYTE_WALLETD_UFVK=

# Loopback by default, deliberately. This service holds spend capability.
BYTE_WALLETD_BIND=127.0.0.1:8137

# main | test
BYTE_WALLETD_NETWORK=test

BYTE_WALLETD_DATA_DIR=./.byte-walletd
BYTE_WALLETD_LIGHTWALLETD=https://testnet.zec.rocks:443
BYTE_WALLETD_ACCOUNT=0

# error | warn | info | debug | trace
BYTE_WALLETD_LOG=info
