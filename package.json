{
  "name": "byte-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy layer for AI agent payments, settling in shielded Zcash",
  "license": "MIT",
  "author": "Asuzu",
  "repository": {
    "type": "git",
    "url": "https://github.com/Afghanistan8/byte-protocol"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "clean": "pnpm -r exec rm -rf dist",
    "demo": "pnpm --filter @byte-protocol/example-agent-marketplace demo",
    "console": "pnpm --filter @byte-protocol/example-agent-marketplace console",
    "test:testnet": "tsx scripts/testnet-e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "tsx": "^4.20.6",
    "@byte-protocol/adapter-x402": "workspace:*",
    "@byte-protocol/client": "workspace:*",
    "@byte-protocol/core": "workspace:*",
    "@byte-protocol/server": "workspace:*",
    "@byte-protocol/stores": "workspace:*",
    "@byte-protocol/wallet": "workspace:*"
  },
  "packageManager": "pnpm@12.6.0"
}